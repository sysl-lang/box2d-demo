// A Box2D playground for sysl — three packages, each doing the one thing it is for.
//
// **box2d** decides where everything is, **cairo** cuts the shapes and **sdl3** turns the crank.
// None of them knows about the others: the join between the last two is one buffer of ARGB32 pixels,
// which is cairo's native format and one of SDL's texture formats and the same bytes on a
// little-endian machine, so nothing is converted at all.

package {
  name    = "box2d-demo"
  version = "0.1.0"
}

dependencies {
  box2d { git = "github.com/sysl-lang/box2d", version = "0.1.0" }
  cairo { git = "github.com/sysl-lang/cairo", version = "0.3.2" }
  sdl3  { git = "github.com/sysl-lang/sdl3",  version = "0.3.0" }
}

requires {
  os   = true
  heap = true
}

// `box2d` needs nothing installed — it carries Box2D's own C. `cairo` and `sdl3` each want a library
// this machine has to have, and each names it so that pkg-config can be asked where it is:
//
//     brew install cairo sdl3
//     sysl run .
//
// Where a prefix lives is still a fact about a machine rather than a property of a package, which is
// why `design/15 §8` will not let this file say it. What changed is who answers: the machine, rather
// than a reader copying its layout onto a command line — and getting it right, which meant knowing
// that cairo's headers sit in `include/cairo` while SDL3's want the directory *above* `SDL3`.
//
// Needs sysl 0.0.56, cairo 0.3.2 and sdl3 0.2.1. On a machine with no pkg-config the two
// `--include-path` flags still answer it.
